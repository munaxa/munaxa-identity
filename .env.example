# Copy to .env for local development. Every variable is validated at startup by @identity/config;
# a missing or invalid value fails the process with every problem listed, rather than surfacing
# later as a token nobody can verify.

NODE_ENV=development
APP_NAME=munaxa-identity
APP_VERSION=0.1.0
BUILD_SHA=local

HOST=0.0.0.0
PORT=4001

# Runtime connection, as the restricted NOBYPASSRLS role. Migrations run separately as the owner.
DATABASE_URL=postgresql://identity_app:identity_app@localhost:5432/identity
DATABASE_POOL_SIZE=10

# Empty selects an in-process cache, which is correct for a single-process development run and
# refused in production: without a shared store, login lockout stops being a limit and the
# permission cache diverges per replica.
REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug
LOG_PRETTY=true

# Proxies in front of the service (Express `trust proxy`). The login rate limit counts per client
# address; with 0 behind a load balancer every client shares the balancer's address and one counter.
# 0 when reached directly; 1 behind one load balancer (the shared AWS stack's ALB).
TRUST_PROXY_HOPS=0

# The issuer. This exact string becomes the `iss` claim, and Munaxa Work compares it character for
# character against its PLATFORM_AUTH_ISSUER. It must be the service's public base URL — the one
# the browser reaches through the shared origin — not an internal address.
IDENTITY_BASE_URL=http://localhost:4001
IDENTITY_AUTH_AUDIENCE=munaxa-work

# The organisation a sign-in belongs to when the form does not name one. Empty means every sign-in
# must name its organisation. A convenience over an existing row, never a bypass.
IDENTITY_DEFAULT_ORGANISATION=

# Access tokens are ES256 and nothing else. A symmetric algorithm would give every verifier — Work
# included — the key that mints the tokens it checks.
IDENTITY_SIGNING_ALGORITHM=ES256
IDENTITY_SIGNING_KID=identity-development-0000-00
# Generate with `pnpm keys:generate`. The private half belongs in the deployment's secret store and
# NEVER in this file, in a repository, or in a log. The value below is intentionally absent rather
# than a placeholder that looks usable.
IDENTITY_SIGNING_PRIVATE_KEY=

# Pepper for refresh-token hashes and for CSRF/cookie signing. A stolen database cannot be used to
# look a refresh token up without it. 32+ characters; set per deployment, never committed.
IDENTITY_SIGNING_SECRET=

# TOTP MFA key ring: kid=key[,kid=key…], each key exactly 32 random bytes in base64url. Seals TOTP
# secrets (AES-256-GCM, bound to tenant, account and method) and keys recovery-code hashes. It must
# be dedicated material: startup refuses IDENTITY_SIGNING_SECRET or the signing key here. Required
# in production, supplied as MFA_ENCRYPTION_KEYS_FILE. Empty in development means MFA is unavailable,
# never unencrypted. Generate one entry with:
#   node -e "console.log('mfa-' + new Date().toISOString().slice(0,7) + '=' + require('crypto').randomBytes(32).toString('base64url'))"
# Rotation (add a key, make it primary, re-encrypt, retire the old one): docs/runbooks/mfa.md.
MFA_ENCRYPTION_KEYS=
# Which entry new secrets are sealed under. Not secret.
MFA_ENCRYPTION_PRIMARY_KID=

# Who must use MFA: off (optional for everybody), privileged (holders of MFA_PRIVILEGED_ROLES), all.
# Enforcement is refused at startup without MFA_ENCRYPTION_KEYS. There is no exemption list.
MFA_POLICY=off
# Comma-separated role keys that count as privileged, e.g. control-operator-admin.
MFA_PRIVILEGED_ROLES=
# The pending second-factor challenge after a correct password, and its attempt limit.
MFA_CHALLENGE_TTL=5m
MFA_ENROLLMENT_CHALLENGE_TTL=10m
MFA_CHALLENGE_MAX_ATTEMPTS=5
# Wrong second-factor answers per account (across challenges) per LOGIN_LOCKOUT window.
MFA_ACCOUNT_MAX_FAILURES=10
# How recent a reauthentication must be to enrol, replace, remove or regenerate recovery codes.
MFA_REAUTH_WINDOW=5m
# The issuer label authenticator apps display.
MFA_ISSUER=Munaxa

# What the session list shows of each session's address: prefix (the /24 or /48) or hidden.
IDENTITY_SESSION_LIST_IP=prefix

SESSION_IDLE_TIMEOUT=15m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_MAX_CONCURRENT=10
SESSION_COOKIE_MAX_AGE=15m
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# The public origins a browser may post a sign-in from. Empty is refused: it would accept every
# cross-site post.
CSRF_TRUSTED_ORIGINS=http://localhost:3001

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY=5
PASSWORD_BREACH_CHECK=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT=15m
AUDIT_ENABLED=true

# ─── Password recovery and email delivery (docs/runbooks/password-recovery.md) ───
# enabled | disabled. Production refuses `enabled` until a production email transport exists, so a
# production deployment sets `disabled` today. Disabled answers every recovery route with 404.
IDENTITY_PASSWORD_RESET=enabled
# The absolute URL of the reset page as the browser reaches it. Reset links are built from this
# and never from the request's Host header. Its origin must be in CSRF_TRUSTED_ORIGINS. No query
# string, no fragment.
IDENTITY_PASSWORD_RESET_URL=
# Lifetime of a reset link: at least 1m, at most 1h.
IDENTITY_PASSWORD_RESET_TTL=30m
# none | outbox. `none` makes recovery answer "unavailable" and writes no tokens. `outbox` writes
# each message, live link included, to a JSON file in IDENTITY_EMAIL_OUTBOX_DIR: development only,
# refused in production.
IDENTITY_EMAIL_TRANSPORT=none
IDENTITY_EMAIL_FROM=
IDENTITY_EMAIL_OUTBOX_DIR=

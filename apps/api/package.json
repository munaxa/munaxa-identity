{
  "name": "@identity/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no unit tests: this package is adapters and wiring, both proved against a real database in packages/testing'",
    "test:integration": "echo 'integration suites live in @identity/testing, which imports these adapters directly'",
    "lint": "echo 'lint: typecheck and format:check cover this package'",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:bootstrap-account": "node scripts/bootstrap-account.mjs",
    "db:seed-work-roles": "node scripts/seed-work-roles.mjs",
    "keys:generate": "node scripts/generate-signing-key.mjs",
    "check:catalogue-drift": "node scripts/check-catalogue-drift.mjs",
    "catalogue:refresh": "node scripts/refresh-work-catalogue.mjs"
  },
  "dependencies": {
    "@identity/config": "workspace:*",
    "@munaxa/audit": "^2.4.1",
    "@munaxa/auth": "^2.4.1",
    "@munaxa/cache": "^2.4.1",
    "@munaxa/config": "^2.4.1",
    "@munaxa/crypto": "^2.4.1",
    "@munaxa/interfaces": "^2.4.1",
    "@munaxa/rbac": "^2.4.1",
    "@munaxa/security": "^2.4.1",
    "@munaxa/session": "^2.4.1",
    "@munaxa/types": "^2.4.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.2.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@identity/testing": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.2.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
